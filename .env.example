# Database (PostgreSQL — Neon)
# Isi dengan connection string kamu sendiri. JANGAN commit file .env asli.
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Session (jose HMAC). Wajib minimal 32 karakter acak.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# AES-256-GCM key untuk enkripsi TOTP secret (32-byte, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Admin awal — dipakai oleh seed. Isi dengan milikmu sendiri.
ADMIN_EMAIL=""
ADMIN_DISPLAY_NAME=""
ADMIN_HANDLE=""

# NextAuth (cadangan)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
