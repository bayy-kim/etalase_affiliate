# Database (PostgreSQL — Neon)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Session (jose HMAC). Wajib minimal 32 karakter acak.
SESSION_SECRET="generate-me-with-:-openssl-rand-hex-32"

# AES-256-GCM key untuk enkripsi TOTP secret (32-byte, base64).
ENCRYPTION_KEY=""

# Admin awal — dipakai oleh seed & fallback demo (saat DATABASE_URL belum di-set).
ADMIN_EMAIL="admin@etalase.com"
ADMIN_PASSWORD="changeme"
ADMIN_DISPLAY_NAME="Bayu"
ADMIN_HANDLE="@namatiktokkamu"

# NextAuth (jika suatu saat dipakai)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
